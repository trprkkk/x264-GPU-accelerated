+         * approximate SAD is clearly worse than the best of the other
+         * analysed references for the same macroblock, it is only matched
+         * against its GPU candidates -- no CPU full-pel search and no
+         * sub-pel refinement.  The real CPU cost function still decides, and
+         * a reference without candidates is never pruned. */
+        int i_prune_pct = h->param.analyse.i_gpu_me_prune;
+        if( cand && i_prune_pct >= 100 && i_gpu_mode >= 2 )
+        {
+            uint32_t mine = cand[0].sad, other = 0xFFFFFFFFu;
+            for( int r = 0; r < X264_GPU_MAX_REFS; r++ )
+            {
+                if( r == m->i_ref )
+                    continue;
+                int nc = 0;
+                const x264_gpu_cand_t *c = x264_gpu_frame_get( gframe, m->i_list, r,
+                                                               h->mb.i_mb_x, h->mb.i_mb_y, &nc );
+                if( c && c[0].sad < other )
+                    other = c[0].sad;
+            }
+            if( other != 0xFFFFFFFFu &&
+                (uint64_t)mine * 100 > (uint64_t)other * (uint32_t)i_prune_pct )
+                b_gpu_pruned = 1;
+        }
+        if( cand )
+            for( int i = 0; i < ncand; i++ )
+            {
+                int mx = cand[i].mv[0] - m->i_xoff;
+                int my = cand[i].mv[1] - m->i_yoff;
+                int dup = 0;
+                for( int j = 0; j < i; j++ )
+                    if( cand[j].mv[0] - m->i_xoff == mx &&
+                        cand[j].mv[1] - m->i_yoff == my )
+                    {
+                        dup = 1;
+                        break;
+                    }
+                if( dup || !CHECK_MVRANGE( mx, my ) )
